@model Cliente
@{
    ViewData["Title"] = "Agregar cliente";
}
<section class="page-heading"><div><p class="eyebrow">REGISTROS</p><h1>Agregar cliente</h1><p class="muted">Registra los datos para utilizar el cliente en una reserva.</p></div><a class="btn btn-outline" asp-action="Index">← Volver</a></section>
<section class="panel form-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Codigo">Código</label><input asp-for="Codigo" class="input" placeholder="Ej. CLI-004" /><span asp-validation-for="Codigo" class="field-error"></span>
        <label asp-for="Nombres"></label><input asp-for="Nombres" class="input" /><span asp-validation-for="Nombres" class="field-error"></span>
        <label asp-for="Apellidos"></label><input asp-for="Apellidos" class="input" /><span asp-validation-for="Apellidos" class="field-error"></span>
        <div class="form-actions"><a class="btn btn-outline" asp-action="Index">Cancelar</a><button class="btn btn-primary" type="submit">Guardar cliente</button></div>
    </form>
</section>
